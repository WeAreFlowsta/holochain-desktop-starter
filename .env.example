# Your app's client id from dev.flowsta.com (Register Your App). The page
# and the Rust side are both built with it (src-tauri/build.rs reads this
# file too). Copy this file to .env and fill it in.
VITE_FLOWSTA_CLIENT_ID=your_client_id_here

# Your own bootstrap and relay server, read at build time by
# src-tauri/src/conductor.rs. Leave them unset while trying things out: the
# app then uses the public Holochain test servers. Set them before you
# release (README, "Servers").
#
# STARTER_BOOTSTRAP_URL=https://bootstrap.example.org
# STARTER_RELAY_URL=https://bootstrap.example.org./   (only if your relay is on another host than your bootstrap server)
#
# Only if your bootstrap server has an authentication hook: the bytes it
# expects, as standard base64 WITH = padding.
# STARTER_AUTH_MATERIAL=
